{
  "name": "dsh-gemini-image",
  "version": "0.1.0",
  "description": "Generate and edit images with Google's Gemini Nano Banana 2.1 model through one model-facing tool, using the Google API key the profile already stores for its Google chat provider.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.3-alpha.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "gemini",
    "image-generation",
    "nano-banana",
    "google"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
