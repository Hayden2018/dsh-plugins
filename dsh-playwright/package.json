{
  "name": "playwright-browser",
  "version": "0.5.1",
  "description": "Playwright browser automation tools for DSH: open pages, click, type, fill, extract, screenshot.",
  "type": "module",
  "files": [
    "lib/",
    "assets/",
    "scripts/",
    "README.md",
    "SITE-MAP-SPEC.md",
    "cordis.patch.yml"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./skill-provider": "./lib/skill-provider.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./assets/locale/*.json",
    "./icon": "./assets/icon.svg",
    "./skill-provider/locale/*.json": "./assets/skill-locale/*.json",
    "./skill-provider/icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "playwright-core": "^1.62.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": "^0.2.0-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "playwright",
    "browser-automation",
    "web-scraping"
  ],
  "license": "MIT"
}
