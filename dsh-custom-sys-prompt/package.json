{
  "name": "dsh-custom-sys-prompt",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Per-mode system-prompt additions with a settings preview, bundled with the Agent and Chat modes.",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.5"
  },
  "main": "./index.js",
  "scripts": {
    "check": "node --check client.js && node --check index.js && node --check gate.js && node --check chat-tools.js && node --check sections.js",
    "test": "node tests/smoke.mjs && node tests/client.mjs"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./gate": "./gate.js",
    "./chat-tools": "./chat-tools.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "gate.js",
    "chat-tools.js",
    "sections.js",
    "client.js",
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/custom.patch.yml",
        "./presets/chat.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
