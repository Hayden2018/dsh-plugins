{
  "name": "dsh-prompt-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Per-mode system-prompt additions with a settings preview.",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./index.js",
  "scripts": {
    "check": "node --check client.js && node --check index.js",
    "test": "node tests/smoke.mjs && node tests/client.mjs"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
